# ========================================================
# 100% Free & Open-Source Configuration (No Paid Services)
# ========================================================

# Database Configuration (Docker MongoDB)
MONGODB_URI=mongodb://root:admin@mongo:27017/chatApp?authSource=admin&retryWrites=true&w=majority

# JWT Configuration (Secret key for auth tokens)
JWT_SECRET=super_secret_jwt_key_12345

# Server Configuration
PORT=5001
NODE_ENV=production

# HTTP Mode (Works on raw IP like http://3.6.36.57 without SSL/HTTPS domain)
SECURE_COOKIE=false
